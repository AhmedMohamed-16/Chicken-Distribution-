+
+  const where = { buyer_id: buyerId };
+
+  if (startDate || endDate) {
+    where.payment_date = {};
+    if (startDate) where.payment_date[sequelize.Sequelize.Op.gte] = startDate;
+    if (endDate)   where.payment_date[sequelize.Sequelize.Op.lte] = endDate;
